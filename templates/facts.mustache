{{!
    @template local_logexplainer/facts
}}
<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
        <tr>
            <th>{{#str}} evidenceid, local_logexplainer {{/str}}</th>
            <th>{{#str}} time, local_logexplainer {{/str}}</th>
            <th>{{#str}} event, local_logexplainer {{/str}}</th>
            <th>{{#str}} component, local_logexplainer {{/str}}</th>
            <th>{{#str}} context, local_logexplainer {{/str}}</th>
            <th>{{#str}} details, local_logexplainer {{/str}}</th>
        </tr>
        </thead>
        <tbody>
        {{#events}}
            <tr>
                <td><strong>{{id}}</strong></td>
                <td>{{time}}</td>
                <td>
                    {{#url}}<a href="{{{url}}}">{{eventname}}</a>{{/url}}
                    {{^url}}{{eventname}}{{/url}}
                    <div class="small text-muted">{{eventclass}}</div>
                </td>
                <td>{{component}} / {{action}} / {{target}}</td>
                <td>{{context}}</td>
                <td>
                    {{description}}
                    {{#objectid}}
                        <div class="small text-muted">objectid={{objectid}}</div>{{/objectid}}
                    {{#relateduserid}}
                        <div class="small text-muted">relateduserid={{relateduserid}}</div>{{/relateduserid}}
                    {{#origin}}
                        <div class="small text-muted">origin={{origin}}</div>{{/origin}}
                </td>
            </tr>
        {{/events}}
        </tbody>
    </table>
</div>
