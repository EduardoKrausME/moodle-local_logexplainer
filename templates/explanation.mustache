{{!
    @template local_logexplainer/explanation
}}
<div class="local-logexplainer-explanation">
    <h4>{{#str}} summary, local_logexplainer {{/str}}</h4>
    <ul>
        {{#summary}}
            <li>{{text}} <span class="text-muted">({{#evidence_ids}}{{.}} {{/evidence_ids}})</span></li>
        {{/summary}}
        {{^summary}}
            <li class="text-muted">—</li>{{/summary}}
    </ul>

    <h4>{{#str}} timeline, local_logexplainer {{/str}}</h4>
    <ol>
        {{#timeline}}
            <li>{{text}} <span class="text-muted">({{#evidence_ids}}{{.}} {{/evidence_ids}})</span></li>
        {{/timeline}}
        {{^timeline}}
            <li class="text-muted">—</li>{{/timeline}}
    </ol>

    <h4>{{#str}} hypotheses, local_logexplainer {{/str}}</h4>
    <ul>
        {{#hypotheses}}
            <li>{{text}} <span class="text-muted">({{#evidence_ids}}{{.}} {{/evidence_ids}})</span></li>
        {{/hypotheses}}
        {{^hypotheses}}
            <li class="text-muted">—</li>{{/hypotheses}}
    </ul>

    <h4>{{#str}} gaps, local_logexplainer {{/str}}</h4>
    <ul>
        {{#gaps}}
            <li>{{.}}</li>{{/gaps}}
        {{^gaps}}
            <li class="text-muted">—</li>{{/gaps}}
    </ul>
</div>
